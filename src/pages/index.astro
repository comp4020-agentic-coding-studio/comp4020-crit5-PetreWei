---
import Layout from "../layouts/Layout.astro";
import "../styles/game.css";
---

<Layout
  title="Detour"
  description="A small browser puzzle: a grid, a runner, and the long way round."
>
  <header class="masthead">
    <div class="masthead__title">
      <h1>Detour</h1>
      <p class="tagline">A grid, a runner, and the long way round.</p>
    </div>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main class="page">
    <div id="progress" class="progress"></div>
    <div class="stage">
      <div id="board" class="board"></div>
      <div id="curtain" class="curtain" hidden></div>
      <button id="start" class="start" type="button" hidden>Start</button>
      <button id="hint" class="solution" type="button" hidden>Show solution</button>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
