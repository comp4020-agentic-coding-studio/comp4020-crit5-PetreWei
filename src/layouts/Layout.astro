---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

// Derived from the base rather than hardcoded, so it survives being carried
// into next week's repo --- an icon path with last week's repo name in it
// resolves on localhost and 404s on the live URL.
const favicon = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`;

const { title, description = "Replace this with one sentence saying what this page is. A search result and a link preview both show it." } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />

    <!-- Without this the browser asks for /favicon.ico and shows a blank
         page icon in the tab when it 404s. -->
    <link rel="icon" type="image/svg+xml" href={favicon} />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/comp4020-crit5-PetreWei/card.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
